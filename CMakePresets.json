{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug with Clang 19",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "CC": "clang-19",
        "CXX": "clang++-19"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "$env{CXX}",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Debug with ASan and UBSan",
      "inherits": "debug",
      "cacheVariables": { "TRADING_SANITIZERS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } }
  ]
}
